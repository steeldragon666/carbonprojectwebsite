# Where the enquiry form posts. Leave unset and the form hands the enquiry to
# the visitor's mail client instead, so a lead is never silently lost.
#
#   Cloudflare Pages Function shipped in this repo:  /api/enquiry
#   Formspree:                                       https://formspree.io/f/xxxxxxx
#   Web3Forms:                                       https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=

# Only needed if you deploy the Cloudflare Pages Function in functions/api/.
# Set it in the Cloudflare dashboard, not in this file.
# RESEND_API_KEY=
# ENQUIRY_TO=aaron@carbonproject.com.au
# ENQUIRY_FROM=website@carbonproject.ai
