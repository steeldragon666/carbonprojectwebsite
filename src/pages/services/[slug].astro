---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placard from '../../components/Placard.astro';
import Plate from '../../components/Plate.astro';
import Faq from '../../components/Faq.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { services, type ServiceDetail } from '../../data/services';
import { site, enquiryTopics } from '../../data/site';
import hall from '../../assets/plates/hall.png';
import gpu from '../../assets/plates/gpu.png';
import robot from '../../assets/plates/robot.png';
import busbar from '../../assets/plates/busbar.png';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
interface Props { service: ServiceDetail }
const { service } = Astro.props;

const topicMap: Record<string, (typeof enquiryTopics)[number]> = {
  'sovereign-inference': 'Sovereign inference capacity',
  'fine-tuning': 'Fine-tuning or model testing',
  'ai-robotics-consulting': 'AI and robotics consulting',
  'facility-upgrade': 'Facility audit and upgrade',
};
const plateMap: Record<string, { src: any; alt: string }> = {
  'sovereign-inference': { src: hall, alt: 'Rows of dark server racks receding into shadow, one warm light along an edge' },
  'fine-tuning': { src: gpu, alt: 'Macro of a heatsink fin array and copper bar lit from one side' },
  'ai-robotics-consulting': { src: robot, alt: 'A six-axis robot arm in silhouette against a single warm work light' },
  'facility-upgrade': { src: busbar, alt: 'A thick copper busbar with bolted lugs inside a switchboard' },
};
const plate = plateMap[service.slug]!;
const others = services.filter((s) => s.slug !== service.slug);

const schema = [
  { '@type': 'Service', '@id': `${site.url}${service.href}#service`, name: service.title, description: service.summary, url: `${site.url}${service.href}`, serviceType: service.metaTitle, provider: { '@id': `${site.url}/#organisation` }, areaServed: { '@type': 'Country', name: 'Australia' } },
  { '@type': 'FAQPage', '@id': `${site.url}${service.href}#faq`, mainEntity: service.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
    { '@type': 'ListItem', position: 3, name: service.title, item: `${site.url}${service.href}` } ] },
];
---
<Base title={service.metaTitle} description={service.metaDescription} image={`/og/${service.slug}.png`} schema={schema}>
  <PageHeader title={service.title} lede={service.lede} crumbs={[{ label: 'Services', href: '/services/' }]}>
    <p class="tag" style="margin-block-start:1.5rem">{service.bought.replace(/^Bought as /, '')}<span>{service.leadTime}</span></p>
  </PageHeader>

  <div class="wrap wall wall--top">
    <Placard tone="black" i={1}>
      <div class="split">
        <div>
          <h2>What you get</h2>
          <Plate src={plate.src} alt={plate.alt} ratio="4 / 3" class="sv__plate" />
        </div>
        <ul class="list list--lg">{service.deliverables.map((d) => <li>{d}</li>)}</ul>
      </div>
    </Placard>

    {service.sections.map((s, n) => (
      <Placard tone={n % 2 === 0 ? 'yellow' : 'black'} i={2 + n}>
        <div class="split">
          <h2 class="h-mid">{s.heading}</h2>
          <div class="flow">
            {s.body && <p class="sub">{s.body}</p>}
            {s.list && <ul class="list">{s.list.map((li) => <li>{li}</li>)}</ul>}
          </div>
        </div>
      </Placard>
    ))}

    <Placard tone="yellow" i={5}>
      <div class="split">
        <div>
          <h2 class="h-mid">How the money works</h2>
          <p class="sub" style="margin-block-start:1rem;max-width:40ch">Every price is quoted in writing before work starts. We do not publish rate cards because the honest number depends on scope, but you will never be asked to approve a range.</p>
        </div>
        <dl class="plate">{service.commercial.map((c) => (<div><dt>{c.k}</dt><dd>{c.v}</dd></div>))}</dl>
      </div>
    </Placard>

    <Placard tone="black" i={6}>
      <div class="split">
        <h2 class="h-mid">What we need from you</h2>
        <div>
          <ul class="list">{service.inputs.map((i) => <li>{i}</li>)}</ul>
          <div class="notfor">
            <h3>What this is not</h3>
            <p class="sub">{service.notFor}</p>
          </div>
        </div>
      </div>
    </Placard>

    <Placard tone="yellow" i={7}>
      <div class="split">
        <h2 class="h-mid">Questions we get asked</h2>
        <Faq items={service.faq} />
      </div>
    </Placard>

    <Placard tone="black" i={8}>
      <div class="split">
        <div>
          <h2 class="h-mid">Start with a scoping call</h2>
          <p class="sub" style="margin-block-start:1rem;max-width:40ch">Fixed fee, credited against delivery. You leave with a written brief whether or not you engage us further.</p>
          <p class="small" style="margin-block-start:1rem">Or email <a class="lk" href={`mailto:${site.email}`}>{site.email}</a>.</p>
        </div>
        <EnquiryForm id={`enq-${service.slug}`} topic={topicMap[service.slug]} />
      </div>
    </Placard>

    <Placard tone="yellow" i={9}>
      <h2 class="h-mid">Also from us</h2>
      <ul class="rel">
        {others.map((o) => (
          <li>
            <h3><a href={o.href}>{o.title}</a></h3>
            <p class="sub small">{o.summary}</p>
          </li>
        ))}
      </ul>
    </Placard>
  </div>
</Base>

<style>
  .wall--top { margin-block-start: clamp(0.9rem, 0.5rem + 1.6vw, 1.75rem); padding-block-end: var(--band); }
  .h-mid { font-size: var(--t2); }
  .sv__plate { margin-block-start: 1.75rem; }
  .list--lg li { font-size: var(--t1); }
  .notfor { margin-block-start: 2rem; padding: 1.25rem; border: 2px solid var(--fg); }
  .notfor h3 { font-size: var(--t1); margin-block-end: 0.5rem; }
  .rel { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 1.5rem; border-top: 2px solid var(--fg); }
  @media (min-width: 52rem) { .rel { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }
  .rel li { padding-block-start: 1rem; }
  .rel h3 { font-size: var(--t1); margin-block-end: 0.5rem; }
  .rel h3 a { text-decoration: none; }
  .rel h3 a:hover { text-decoration: underline; }
</style>
