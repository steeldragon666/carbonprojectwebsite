---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { site } from '../../data/site';
---
<Base
  title="Enquiry received"
  description="Thank you — your enquiry has reached Carbon Project Australia."
  noindex={true}>
  <Section rule={false}>
    <div class="done">
      <p class="anno anno--ink">Enquiry received</p>
      <h1>Thank you — that reached us.</h1>
      <p class="lede" style="margin-block-start:1.25rem">
        {site.responseTime} If it is urgent, email
        <a href={`mailto:${site.email}`}>{site.email}</a> directly and say so in the subject line.
      </p>
      <div class="done__actions">
        <a class="btn" href="/">Back to the front page</a>
        <a class="btn btn--ghost" href="/how-we-work/">How an engagement runs</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .done { padding-block: clamp(1rem, 0.5rem + 3vw, 4rem); max-width: 48ch; }
  .done h1 { margin-block-start: 1rem; font-size: var(--step-4); }
  .done a { color: var(--action); }
  .done__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: 2rem; }
  .done__actions a { color: inherit; }
</style>
