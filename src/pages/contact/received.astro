---
import Base from '../../layouts/Base.astro';
import Placard from '../../components/Placard.astro';
import { site } from '../../data/site';
---
<Base title="Enquiry received" description="Thank you — your enquiry has reached Carbon Project Australia." noindex={true}>
  <div class="wrap band">
    <Placard tone="yellow" i={0} class="done">
      <h1>That reached us.</h1>
      <p class="lede" style="margin-block-start:1.25rem">{site.responseTime} If it is urgent, email <a class="lk" href={`mailto:${site.email}`}>{site.email}</a> directly and say so in the subject line.</p>
      <div class="done__act">
        <a class="sw" href="/">Back to the front page</a>
        <a class="sw sw--ghost" href="/how-we-work/">How an engagement runs</a>
      </div>
    </Placard>
  </div>
</Base>
<style>
  .done { max-width: 64ch; }
  .done__act { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: 2rem; }
</style>
