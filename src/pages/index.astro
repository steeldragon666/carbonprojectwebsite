---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SingleLine from '../components/SingleLine.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, offers, domains, facilitySpec, engagementSteps, pillars } from '../data/site';

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${site.url}/#webpage`,
    url: `${site.url}/`,
    name: `${site.name} — ${site.tagline}`,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#organisation` },
  },
  ...offers.map((o) => ({
    '@type': 'Service',
    '@id': `${site.url}${o.href}#service`,
    name: o.title,
    description: o.summary,
    url: `${site.url}${o.href}`,
    provider: { '@id': `${site.url}/#organisation` },
    areaServed: { '@type': 'Country', name: 'Australia' },
  })),
];
---
<Base
  title={site.name}
  description={site.description}
  schema={schema}>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__top">
        <h1>Sovereign AI inference, powered on site.</h1>
        <div class="hero__aside">
          <p class="lede">
            We run and fine-tune AI models on hardware we own, at a self-powered research and
            fabrication facility on the Mornington Peninsula, Victoria. Your data stays on our site,
            under Australian jurisdiction, and leaves only when you say it does.
          </p>
          <div class="hero__actions">
            <a class="btn" href="/contact/">Book a scoping call</a>
            <a class="btn btn--ghost" href="/facility/">See what's on site</a>
          </div>
        </div>
      </div>
      <div class="hero__fig">
        <SingleLine />
      </div>
    </div>
  </section>

  <!-- ── Pillars ──────────────────────────────────────────────────────── -->
  <section class="band band--rule pillars-band">
    <div class="wrap">
      <ul class="pillars">
        {pillars.map((p) => (
          <li>
            <h2>{p.title}</h2>
            <p class="small muted">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Offers ───────────────────────────────────────────────────────── -->
  <Section id="services" no="01" label="Ways to engage" alt={true}>
    <div class="split split--wide">
      <div class="split__aside">
        <h2>Four ways to engage. The first two are most of what we do.</h2>
      </div>
      <p class="muted">
        Everything below is delivered from our own facility by the people who built it. Scope is
        fixed in writing before any work starts, and the scoping fee is credited against delivery if
        you proceed.
      </p>
    </div>

    <div class="grid-sheet grid-2 offers">
      {offers.map((o) => (
        <article class="offer">
          <p class="anno">{o.no}</p>
          <h3><a href={o.href}>{o.title}</a></h3>
          <p class="small muted offer__sum">{o.summary}</p>
          <ul class="ticks">
            {o.deliverables.slice(0, 4).map((d) => <li>{d}</li>)}
          </ul>
          <p class="offer__foot">
            <span class="anno">{o.bought}</span>
            <a class="tlink" href={o.href}>{o.linkLabel} →</a>
          </p>
        </article>
      ))}
    </div>
  </Section>

  <!-- ── Power ────────────────────────────────────────────────────────── -->
  <Section id="power" no="02" label="Zero-emission power">
    <div class="split split--wide">
      <div class="split__aside">
        <h2>Power first, then compute.</h2>
        <p class="muted" style="margin-block-start:1.25rem">
          Compute is a power question before it is a silicon question. We hire out the same class of
          hydrogen fuel-cell generation we run ourselves: 250&nbsp;kVA in a compact package, no fumes,
          no mechanical noise, and water as the only by-product — so it goes indoors and into
          noise-restricted sites where a diesel set cannot.
        </p>
        <p style="margin-block-start:1.5rem">
          <a class="btn" href="/power/">Zero-emission power hire</a>
        </p>
      </div>
      <div>
        <dl class="rows">
          <div><dt>Output</dt><dd>250&nbsp;kVA per unit, AC and DC via intelligent controllers</dd></div>
          <div><dt>Current</dt><dd>800&nbsp;A per unit</dd></div>
          <div><dt>Noise</dt><dd>No mechanical noise — deployable in noise-restricted sites</dd></div>
          <div><dt>Emissions</dt><dd>No exhaust, no particulates. Water is the only by-product</dd></div>
          <div><dt>Siting</dt><dd>Grid-tied or standalone; indoor installation possible</dd></div>
          <div><dt>Typical use</dt><dd>Events, construction, mining, data centres and telecommunications</dd></div>
        </dl>
      </div>
    </div>
  </Section>

  <!-- ── Facility ─────────────────────────────────────────────────────── -->
  <Section id="facility" no="03" label="The facility" alt={true}>
    <div class="split split--wide">
      <div class="split__aside">
        <h2>The facility</h2>
        <p class="muted" style="margin-block-start:1.25rem">
          We future-proofed our own site before offering to do yours. Everything we sell runs here
          first.
        </p>
        <p style="margin-block-start:1.5rem">
          <a class="tlink" href="/facility/">Read the facility sheet →</a>
        </p>
      </div>
      <div>
        <dl class="rows">
          {facilitySpec.map((r) => (<div><dt>{r.k}</dt><dd>{r.v}</dd></div>))}
        </dl>
      </div>
    </div>
  </Section>

  <!-- ── Research ─────────────────────────────────────────────────────── -->
  <Section id="research" no="04" label="Research and development">
    <div class="split split--wide">
      <div class="split__aside">
        <h2>Research and development in five domains.</h2>
      </div>
      <p class="muted">
        Carbon Project Australia is the R&amp;D performing entity and research conveyor for its
        partner companies. Each domain below has working hardware behind it, not just a slide.
        <a class="tlink" href="/research/" style="display:inline-block;margin-block-start:0.75rem">See the research sheet →</a>
      </p>
    </div>
    <dl class="rows domains">
      {domains.map((d) => (
        <div>
          <dt>{d.name}</dt>
          <dd>
            {d.body}
            {d.badge && <span class="badge domains__badge">{d.badge}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- ── Process ──────────────────────────────────────────────────────── -->
  <Section id="how" no="05" label="How an engagement runs" alt={true}>
    <div class="split split--wide">
      <div class="split__aside">
        <h2>How an engagement runs.</h2>
      </div>
      <p class="muted">
        Short, fixed and measurable. You see a result before you commit to anything ongoing, and
        nothing rolls over on its own.
        <a class="tlink" href="/how-we-work/" style="display:inline-block;margin-block-start:0.75rem">Read how we work →</a>
      </p>
    </div>
    <ol class="grid-sheet grid-4 steps">
      {engagementSteps.map((s) => (
        <li>
          <span class="steps__n anno">{s.n}</span>
          <h3>{s.title}</h3>
          <p class="small muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ── Contact ──────────────────────────────────────────────────────── -->
  <Section id="contact" no="06" label="Enquiries">
    <div class="split split--wide">
      <div class="split__aside">
        <h2>Tell us what you need.</h2>
        <dl class="rows contact-rows">
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Location</dt><dd>{site.location.region}, {site.location.stateName} — {site.location.note}</dd></div>
          <div><dt>Response</dt><dd>{site.responseTime}</dd></div>
        </dl>
      </div>
      <div>
        <EnquiryForm id="home-enquiry" />
      </div>
    </div>
  </Section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 1.6rem + 4.2vw, 5rem) clamp(2rem, 1.4rem + 3vw, 3.5rem); }
  .hero__top {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2.4vw, 3.5rem);
    align-items: end;
  }
  @media (min-width: 60rem) {
    .hero__top { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  }
  .hero h1 { max-width: 11ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: 1.75rem; }
  .hero__fig { margin-block-start: clamp(2rem, 1.4rem + 2.6vw, 3.25rem); }

  .pillars-band { padding-block: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .pillars {
    display: grid;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 52rem) { .pillars { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem; } }
  .pillars h2 { font-size: var(--step-0); margin-block-end: 0.5rem; }

  .offers { margin-block-start: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem); }
  .offer { display: flex; flex-direction: column; }
  .offer h3 { margin-block: 0.75rem 0.65rem; font-size: var(--step-2); }
  .offer h3 a { text-decoration: none; }
  .offer h3 a:hover { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; }
  .offer__sum { max-width: 46ch; }
  .offer .ticks { margin-block-start: 1.1rem; }
  .offer__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    margin-block-start: auto;
    padding-block-start: 1.5rem;
  }

  .rows { margin-block-start: 0; }
  .rows a { color: var(--action); }
  .domains { margin-block-start: clamp(1.75rem, 1.2rem + 2vw, 2.5rem); }
  .domains dt { font-size: var(--step-1); }
  .domains dd { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: baseline; justify-content: space-between; }
  .domains__badge { flex: none; }
  .contact-rows { margin-block-start: 1.75rem; }

  .steps {
    margin-block-start: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    list-style: none;
    padding: 0;
    counter-reset: none;
  }
  .steps__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 700;
  }
  .steps h3 { margin-block: 0.9rem 0.5rem; }
</style>
