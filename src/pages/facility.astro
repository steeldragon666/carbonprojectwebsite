---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Placard from '../components/Placard.astro';
import Plate from '../components/Plate.astro';
import SingleLine from '../components/SingleLine.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, facilitySpec } from '../data/site';
import peninsula from '../assets/plates/peninsula.png';
import hall from '../assets/plates/hall.png';

const faq = [
  { q: 'Can we visit?', a: 'Yes, by appointment. It is about an hour from Melbourne. Most clients who are serious about jurisdiction come and stand in the room, and we would rather you did.' },
  { q: 'Who has physical access to the hardware?', a: 'A named list, provided in writing as part of any inference agreement, along with what would have to happen for that list to change.' },
  { q: 'What happens when the grid goes down?', a: 'On-site generation and storage carry the load, with zero-emission backup behind that. The design intent is that a grid outage is not an event our clients hear about.' },
  { q: 'Can you run our hardware rather than yours?', a: 'Colocation of client-owned hardware is possible and is scoped case by case. It changes the commercial and the liability shape, so it is a conversation rather than a product.' },
];
const schema = [
  { '@type': 'Place', '@id': `${site.url}/facility/#place`, name: 'Carbon Project Australia research and fabrication facility', address: { '@type': 'PostalAddress', addressLocality: site.location.region, addressRegion: site.location.stateName, addressCountry: site.location.countryCode } },
  { '@type': 'FAQPage', '@id': `${site.url}/facility/#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="The facility" description="A self-powered research and fabrication facility on the Mornington Peninsula, Victoria: GPU compute, on-site generation, robotics and fabrication." image="/og/facility.png" schema={schema}>
  <PageHeader title="We future-proofed our own site first." lede="Everything we sell runs here before it is offered to anyone. Compute, power, robotics and fabrication under one roof on the Mornington Peninsula, about an hour from Melbourne." />

  <div class="wrap wall wall--top">
    <Plate src={peninsula} alt="Coastal scrub on a low ridge at blue hour with a single dark shed and one lit window" ratio="21 / 9" sizes="100vw" loading="eager" />

    <Placard tone="yellow" i={1}>
      <h2 class="h-mid" style="margin-block-end:1.25rem">How the site is wired</h2>
      <SingleLine />
    </Placard>

    <Placard tone="black" i={2}>
      <div class="split">
        <div>
          <h2 class="h-mid">What is on site</h2>
          <p class="sub" style="margin-block-start:1rem;max-width:40ch">Owned and operated by Carbon Project Australia. No sub-let racks, no third-party control plane, no capacity quietly resold when demand spikes.</p>
          <Plate src={hall} alt="Rows of dark server racks receding into shadow, one warm light along an edge" ratio="4 / 3" class="mt" />
        </div>
        <dl class="plate">{facilitySpec.map((r) => (<div><dt>{r.k}</dt><dd>{r.v}</dd></div>))}</dl>
      </div>
    </Placard>

    <Placard tone="yellow" i={3}>
      <div class="split">
        <h2 class="h-mid">Why a single site matters</h2>
        <div class="flow">
          <p class="sub">Sovereignty is not a marketing word here, it is a property of a building. A model served from hardware we own, in a building we control, on a network we designed, has a jurisdiction you can point at. A model served from an abstraction does not.</p>
          <p class="sub">Putting compute, power, robotics and fabrication on the same site also collapses the loop between a design decision and a physical result. When a robotics client needs a bracket changed, it is changed and tested the same week, on the same floor, by the people who specified it.</p>
          <p class="sub">The energy side is the part most people underestimate. Generation, storage and zero-emission backup are what make the compute claim credible: an inference node that goes dark with the grid is not sovereign, it is just local.</p>
        </div>
      </div>
    </Placard>

    <Placard tone="black" i={4}>
      <div class="split"><h2 class="h-mid">Questions we get asked</h2><Faq items={faq} /></div>
    </Placard>
  </div>
  <CtaBand title="Come and stand in the room." body="Visits are by appointment, about an hour from Melbourne. Bring the person who has to sign the risk assessment." primary="Arrange a visit" />
</Base>

<style>
  .wall--top { margin-block-start: clamp(0.9rem, 0.5rem + 1.6vw, 1.75rem); }
  .h-mid { font-size: var(--t2); }
  .mt { margin-block-start: 1.5rem; }
</style>
