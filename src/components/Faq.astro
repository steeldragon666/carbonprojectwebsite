---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><span class="faq__m" aria-hidden="true"></span></summary>
      <p class="sub">{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 2px solid var(--rule); }
  .faq details { border-bottom: 1px solid var(--field); }
  .faq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-block: 1rem; cursor: pointer; list-style: none;
    font-family: var(--display); font-weight: 700; font-size: var(--t1);
    text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.05;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq__m { position: relative; flex: none; width: 1rem; height: 1rem; }
  .faq__m::before, .faq__m::after { content: ''; position: absolute; background: var(--fg); }
  .faq__m::before { top: 6.5px; left: 0; width: 16px; height: 3px; }
  .faq__m::after  { top: 0; left: 6.5px; width: 3px; height: 16px; transition: transform 200ms var(--ease); }
  .faq details[open] .faq__m::after { transform: scaleY(0); }
  .faq details > p { padding-block: 0 1.25rem; max-width: 66ch; }
</style>
