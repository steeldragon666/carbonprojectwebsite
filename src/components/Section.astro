---
interface Props {
  /** Two-digit sheet number, e.g. "01". */
  no?: string;
  /** Small uppercase label beside the number. */
  label?: string;
  id?: string;
  alt?: boolean;
  rule?: boolean;
  class?: string;
}
const { no, label, id, alt = false, rule = true, class: cls = '' } = Astro.props;
---
<section
  id={id}
  class:list={['band', { 'band--alt': alt, 'band--rule': rule && !alt }, cls]}>
  <div class="wrap">
    {(no || label) && (
      <p class="eyebrow anno">
        {no && <span class="eyebrow__no">{no}</span>}
        {label && <span>{label}</span>}
      </p>
    )}
    <slot />
  </div>
</section>

<style>
  .eyebrow__no { color: var(--ink); font-weight: 700; }
</style>
