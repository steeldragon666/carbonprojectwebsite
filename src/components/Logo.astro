---
interface Props { size?: number; class?: string }
const { size = 20, class: cls = '' } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role="img"
  aria-label="Carbon Project Australia"
  fill="none">
  <rect x="0.75" y="0.75" width="22.5" height="22.5" rx="1.25" fill="var(--signal)" />
  <path d="M4.5 15.25h15" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="square" />
  <path d="M7.25 15.25V9.5M12 15.25V6.25M16.75 15.25V11.5" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="square" />
  <rect x="0.75" y="0.75" width="22.5" height="22.5" rx="1.25" stroke="var(--ink)" stroke-width="1.2" />
</svg>
