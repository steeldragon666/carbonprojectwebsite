---
/**
 * An illustrative image plate. Every plate on this site is generated and is
 * labelled as such: none of them is a photograph of the company's facility.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  ratio?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, sizes = '(min-width: 60rem) 50vw, 100vw', ratio = '16 / 9', class: cls = '', loading = 'lazy' } = Astro.props;
---
<figure class:list={['pf', cls]} style={`--ratio:${ratio}`}>
  <Image src={src} alt={alt} widths={[640, 960, 1400, 2000]} sizes={sizes} format="webp" quality={72} loading={loading} decoding="async" />
  <figcaption class="pf__cap">Illustrative image</figcaption>
</figure>

<style>
  .pf { position: relative; border: 2px solid var(--fg); background: var(--black); }
  .pf img { width: 100%; aspect-ratio: var(--ratio); object-fit: cover; }
  .pf__cap {
    position: absolute;
    right: 0; bottom: 0;
    padding: 0.25rem 0.6rem;
    background: var(--black);
    color: var(--ink2-k);
    font-family: var(--body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
</style>
