---
import { site, nav, offers } from '../data/site';
const year = new Date().getFullYear();
const revDate = new Date().toISOString().slice(0, 10);
---
<footer class="site-foot">
  <div class="wrap">
    <!-- Title block, as on a drawing sheet -->
    <div class="titleblock" role="group" aria-label="Document control">
      <div><span class="anno">Company</span><p>{site.legalName}</p></div>
      <div><span class="anno">Sheet</span><p>Capability statement</p></div>
      <div><span class="anno">Location</span><p>{site.location.region}, {site.location.state}</p></div>
      <div><span class="anno">Established</span><p>{site.founded}</p></div>
      <div><span class="anno">Revision</span><p>{site.revision} — {revDate}</p></div>
      <div><span class="anno">Scale</span><p>NTS</p></div>
    </div>

    <div class="foot-nav">
      <nav aria-label="Services">
        <h2 class="anno">Services</h2>
        <ul>
          {offers.map((o) => <li><a href={o.href}>{o.title}</a></li>)}
          <li><a href="/power/">Zero-emission power hire</a></li>
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2 class="anno">Company</h2>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="anno">Enquiries</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="muted small">{site.location.region}, {site.location.stateName}</li>
          <li class="muted small">{site.location.note}</li>
        </ul>
      </div>
      <nav aria-label="Legal">
        <h2 class="anno">Legal</h2>
        <ul>
          <li><a href="/legal/privacy/">Privacy</a></li>
          <li><a href="/legal/terms/">Terms of use</a></li>
        </ul>
      </nav>
    </div>

    <div class="foot-base">
      <p class="small muted">© {year} {site.legalName}. All rights reserved.</p>
      <a href="#top" class="small">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    margin-block-start: auto;
    border-top: 1px solid var(--rule);
    background: var(--sheet-alt);
    padding-block: clamp(2.5rem, 1.8rem + 3vw, 4rem);
  }
  .titleblock {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 48rem) { .titleblock { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .titleblock { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .titleblock > div { background: var(--sheet); padding: 0.85rem 1rem; }
  .titleblock p {
    font-family: var(--display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-block-start: 0.3rem;
    line-height: 1.25;
  }

  .foot-nav {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: 2.5rem;
  }
  @media (min-width: 56rem) { .foot-nav { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem; } }
  .foot-nav h2 { display: block; margin-block-end: 0.85rem; }
  .foot-nav ul { list-style: none; margin: 0; padding: 0; }
  .foot-nav li + li { margin-block-start: 0.5rem; }
  .foot-nav a {
    font-size: var(--step--1);
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .foot-nav a:hover { color: var(--ink); border-bottom-color: var(--rule-strong); }

  .foot-base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: baseline;
    margin-block-start: 2.5rem;
    padding-block-start: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .foot-base a { color: var(--ink-2); text-decoration: none; }
  .foot-base a:hover { color: var(--ink); }
</style>
